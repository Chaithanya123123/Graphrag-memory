# Copy to .env and fill in. Never commit .env.

# Required for: tool-calling router, claim extraction, contradiction labelling,
# answer polish. Without it the app still runs on deterministic templates.
MISTRAL_API_KEY=

# Optional: pin the model used everywhere.
MISTRAL_MODEL=mistral-small-latest

# Optional: raises Semantic Scholar's very low anonymous rate limit.
# Strongly recommended for the live demo, the public limit is ~1 req/sec.
SEMANTIC_SCHOLAR_API_KEY=

FALKOR_HOST=localhost
FALKOR_PORT=6379